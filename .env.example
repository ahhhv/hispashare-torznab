# Copia este archivo a .env (cp .env.example .env) y rellénalo.
# .env NO se copia a la imagen (.dockerignore) ni debe subirse a git.
# Docker Compose lee .env automáticamente para rellenar docker-compose.yml.

# ===== hispashare-torznab =====================================================
# Token personal: https://www.hispashare.org/token/ (con la sesión iniciada)
HISPASHARE_TOKEN=
# Clave que pondrás en Prowlarr/Sonarr/Radarr. Genera una con: openssl rand -hex 16
TORZNAB_APIKEY=

HISPASHARE_API_URL=https://api.hispashare.org
PORT=9118
# Segundos de caché para búsquedas y para el RSS
CACHE_TTL=600
RSS_CACHE_TTL=300
# Páginas máximas de /titles por búsqueda de texto (20 títulos por página)
MAX_PAGES=2
# debug | info | warn | error
LOG_LEVEL=info
# Fuente que se pone en el título para los nombres propios de Hispashare.
# Sonarr/Radarr asignan la calidad según esa fuente (WEBRip, WEB-DL, BluRay...).
SOURCE_MAP=Micro4K:WEBRip,MicroHD:WEBRip

# ===== aMule / aMuTorrent =====================================================
# Contraseña de la interfaz web de aMule
AMULE_WEBUI_PWD=
# Contraseña de conexiones externas (EC) de aMule; aMuTorrent la usa para conectarse
AMULE_EC_PWD=
# Contraseña de la interfaz web de aMuTorrent
AMUTORRENT_PASSWORD=
TZ=Europe/Madrid
# Usuario/grupo dueño de las carpetas (en la Orange Pi: `id tu_usuario`)
PUID=1000
PGID=1000

# ===== Rutas =====================================================================
# Descargas de aMule (compartidas con Sonarr/Radarr). Pon aquí tu disco si tienes uno.
DOWNLOADS=./data/downloads
# Bibliotecas donde Sonarr y Radarr dejan lo importado
MEDIA_TV=/mnt/media/series
MEDIA_MOVIES=/mnt/media/peliculas

# ===== Jellyfin =================================================================
# Dirección con la que se anuncia Jellyfin en tu red
JELLYFIN_URL=http://orangepi5.local:8096
